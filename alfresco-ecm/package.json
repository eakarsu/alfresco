{
  "name": "alfresco-ecm-platform",
  "version": "1.0.0",
  "description": "Enterprise Content Management Platform - Complete Alfresco Implementation",
  "private": true,
  "scripts": {
    "dev": "echo 'Starting development servers...'",
    "build": "echo 'Building all services...'",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest --selectProjects='Unit Tests'",
    "test:integration": "jest --selectProjects='Integration Tests'",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:100": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":100,\"functions\":100,\"lines\":100,\"statements\":100}}'",
    "test:performance": "artillery run tests/performance/load-test.yml",
    "test:security": "npm audit && snyk test",
    "test:accessibility": "playwright test --project=accessibility",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit --project=edge",
    "lint": "echo 'Running linter...'",
    "start:auth": "cd services/auth && npm run dev",
    "start:document": "cd services/document && npm run dev",
    "start:workflow": "cd services/workflow && npm run dev",
    "start:web": "cd apps/web && npm run dev",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "init": "npm install --legacy-peer-deps",
    "db:seed": "psql -U postgres -d alfresco_test -f tests/fixtures/database-seed.sql",
    "db:seed:generate": "node tests/fixtures/test-data-generator.js",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed",
    "db:drop": "dropdb alfresco_test || true",
    "db:create": "createdb alfresco_test",
    "report:open": "open test-results/html/report.html",
    "report:coverage": "open coverage/lcov-report/index.html",
    "report:playwright": "npx playwright show-report test-results/playwright-report",
    "clean:test": "rm -rf test-results coverage .nyc_output",
    "ci:test": "npm run clean:test && npm run db:reset && npm run test:coverage:100",
    "validate": "npm run lint && npm run test:coverage:100"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "artillery": "^2.0.4",
    "eslint": "^8.56.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-playwright": "^0.20.0",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "jest-html-reporters": "^3.1.4",
    "jest-junit": "^16.0.0",
    "jest-playwright-preset": "^4.0.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "puppeteer": "^24.20.0"
  }
}
