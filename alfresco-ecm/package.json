{
  "name": "alfresco-ecm-platform",
  "version": "1.0.0",
  "description": "Quarantined, unsupported ECM reference prototype; not an official Alfresco distribution",
  "private": true,
  "scripts": {
    "verify:reference": "node ../scripts/verify-reference-boundary.cjs",
    "test": "node --test ../tests/reference-boundary.test.cjs",
    "build": "npm run verify:reference",
    "validate": "npm run test",
    "dev": "node ../scripts/deny-reference-execution.cjs dev",
    "start": "node ../scripts/deny-reference-execution.cjs start",
    "deploy": "node ../scripts/deny-reference-execution.cjs deploy",
    "docker:up": "node ../scripts/deny-reference-execution.cjs docker:up",
    "docker:down": "node ../scripts/deny-reference-execution.cjs docker:down",
    "db:migrate": "node ../scripts/deny-reference-execution.cjs db:migrate",
    "db:seed": "node ../scripts/deny-reference-execution.cjs db:seed",
    "db:reset": "node ../scripts/deny-reference-execution.cjs db:reset"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "artillery": "^2.0.4",
    "eslint": "^8.56.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-playwright": "^0.20.0",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "jest-html-reporters": "^3.1.4",
    "jest-junit": "^16.0.0",
    "jest-playwright-preset": "^4.0.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "puppeteer": "^24.20.0"
  }
}
