{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "composite": true,
    "removeComments": true,
    "noEmit": false,
    "importHelpers": true,
    "downlevelIteration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@alfresco/shared/*": ["packages/shared/src/*"],
      "@alfresco/ui-components/*": ["packages/ui-components/src/*"],
      "@alfresco/sdk/*": ["packages/sdk/src/*"],
      "@services/*": ["services/*/src"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/ui-components" },
    { "path": "./packages/sdk" },
    { "path": "./services/auth" },
    { "path": "./services/document" },
    { "path": "./services/workflow" },
    { "path": "./services/search" },
    { "path": "./services/collaboration" },
    { "path": "./services/records" },
    { "path": "./services/integration" },
    { "path": "./services/notification" },
    { "path": "./services/audit" },
    { "path": "./services/admin" },
    { "path": "./apps/web" }
  ]
}