# Alfresco ECM Platform Environment Configuration

# Node Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://alfresco:alfresco_secure_pass@localhost:5432/alfresco_ecm
MONGODB_URI=mongodb://alfresco:alfresco_secure_pass@localhost:27017/alfresco_content

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Storage Configuration
STORAGE_TYPE=s3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=alfresco
MINIO_SECRET_KEY=alfresco_secure_pass
MINIO_USE_SSL=false
MINIO_BUCKET=alfresco-content

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=alfresco
KEYCLOAK_CLIENT_ID=alfresco-app
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@alfresco.local

# Workflow Engine
CAMUNDA_URL=http://localhost:8090
CAMUNDA_USERNAME=admin
CAMUNDA_PASSWORD=admin

# Message Queue
RABBITMQ_URL=amqp://alfresco:alfresco_secure_pass@localhost:5672

# AI Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Cloud Providers
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

AZURE_STORAGE_ACCOUNT=your-azure-storage-account
AZURE_STORAGE_KEY=your-azure-storage-key

GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_KEYFILE=./keys/gcp-service-account.json

# Office Integration
OFFICE365_TENANT_ID=your-tenant-id
OFFICE365_CLIENT_ID=your-client-id
OFFICE365_CLIENT_SECRET=your-client-secret

GOOGLE_WORKSPACE_CLIENT_ID=your-google-client-id
GOOGLE_WORKSPACE_CLIENT_SECRET=your-google-client-secret

# External Services
SLACK_APP_TOKEN=your-slack-app-token
SLACK_BOT_TOKEN=your-slack-bot-token

TEAMS_APP_ID=your-teams-app-id
TEAMS_APP_PASSWORD=your-teams-app-password

JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-jira-email
JIRA_API_TOKEN=your-jira-api-token

SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret

# Analytics
GOOGLE_ANALYTICS_ID=UA-000000-0
MIXPANEL_TOKEN=your-mixpanel-token
SEGMENT_WRITE_KEY=your-segment-write-key

# Monitoring
PROMETHEUS_METRICS_PORT=9090
GRAFANA_URL=http://localhost:3001
GRAFANA_API_KEY=your-grafana-api-key

SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-new-relic-key

# Security
ENCRYPTION_KEY=your-256-bit-encryption-key
ENCRYPTION_ALGORITHM=aes-256-gcm

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_SECRET=your-csrf-secret

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SSL/TLS
TLS_KEY_PATH=./certs/server.key
TLS_CERT_PATH=./certs/server.crt
TLS_CA_PATH=./certs/ca.crt

# Feature Flags
FEATURE_AI_ENABLED=true
FEATURE_WORKFLOW_ENABLED=true
FEATURE_RECORDS_MANAGEMENT_ENABLED=true
FEATURE_DAM_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_REALTIME_COLLABORATION_ENABLED=true

# Performance
MAX_FILE_SIZE=5368709120
MAX_CONCURRENT_UPLOADS=10
WORKER_THREADS=4
CLUSTER_WORKERS=auto

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/alfresco.log
LOG_MAX_SIZE=100m
LOG_MAX_FILES=14d

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=s3://alfresco-backups

# Multi-tenancy
MULTI_TENANT_MODE=false
DEFAULT_TENANT=default

# License
LICENSE_KEY=your-alfresco-license-key
LICENSE_TYPE=enterprise